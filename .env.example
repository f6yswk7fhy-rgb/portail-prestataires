# Copier en .env et compléter. Ne jamais committer le fichier .env.
# Clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
PORTAIL_SECRET_KEY=
PORTAIL_ALLOWED_HOSTS=prestataires.etablissement.local
PORTAIL_CSRF_TRUSTED_ORIGINS=https://prestataires.etablissement.local
PORTAIL_PROXIES_DE_CONFIANCE=10.0.0.10
PORTAIL_NOM_ETABLISSEMENT=Centre hospitalier
PORTAIL_DEBUG=0

POSTGRES_DB=portail
POSTGRES_USER=portail
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SSO Entra ID pour le personnel (application à enregistrer dans Entra ID,
# URI de redirection : https://<hôte>/oidc/callback/, revendication « groups » activée).
ENTRA_TENANT_ID=
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
# Identifiants des groupes AD synchronisés -> rôles du portail.
OIDC_GROUPES_ROLES={"00000000-0000-0000-0000-000000000001": "RSSI", "00000000-0000-0000-0000-000000000002": "DSI"}

PORTAIL_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
PORTAIL_SMTP_HOTE=smtp.etablissement.local
PORTAIL_SMTP_PORT=25
PORTAIL_EMAIL_EXPEDITEUR=portail-prestataires@etablissement.local
